  "files": [
    "src",
    "react-native.config.js",
    "metro.js",
    "lib",
    "deps",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src/**",
    "ios/**/*.a",
    "ios/**/*.h",
    "ios/**/*.c",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.hpp",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "ios/**/*.plist",
    "!ios/openssl",
    "app.plugin.js",
    "*.podspec",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
